{
  "name": "opencookie",
  "version": "0.1.0",
  "description": "Open-source, self-hosted cookie consent manager with automatic cookie scanning, the Open Cookie Database and per-country rule packs (Dutch AP, EDPB, CNIL, UK, US GPC).",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "node src/server/index.ts",
    "dev": "node scripts/build.ts && node --watch src/server/index.ts",
    "cookie-db:update": "node scripts/update-cookie-db.ts",
    "translate": "node scripts/translate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8"
  },
  "optionalDependencies": {
    "playwright": "^1.65.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "preact": "^11.2.0",
    "typescript": "^5.9.0"
  }
}
