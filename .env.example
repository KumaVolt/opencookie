# Copy to .env and fill in.

# Public HTTPS address of this server (used in the embed snippet).
PUBLIC_URL=https://consent.example.com

# Password for the admin dashboard at /admin/.
ADMIN_PASSWORD=change-me

# Random secret used to hash visitor IP addresses in the consent log.
# Generate one with: openssl rand -hex 32
SECRET=

# Optional
# PORT=8080
# SCAN_MAX_PAGES=20
# DEEPL_API_KEY=            # for "npm run translate -- --provider deepl"
# LIBRETRANSLATE_URL=       # for "npm run translate -- --provider libretranslate"
