# Copy to .env and fill in.

# Public HTTPS address of this server (used in embed snippets, emails and passkeys).
PUBLIC_URL=https://consent.example.com

# Needed once, to create the first admin account at /admin/.
SETUP_KEY=change-me

# Hashes visitor IP addresses and encrypts 2FA secrets. Generate with: openssl rand -hex 32
# If empty, one is generated in DATA_DIR/secret.key (back that file up).
SECRET=

# Optional
# SMTP_URL=smtps://user:pass@smtp.example.com:465   # invitations and password resets by email
# MAIL_FROM=OpenCookie <consent@example.com>
# REQUIRE_2FA=true                                   # every user must add a passkey or authenticator app
# GRAVATAR=true                                      # profile photos from Gravatar (sends email hashes to Gravatar)
# APP_NAME=OpenCookie
# SESSION_HOURS=12
# PORT=8080
# SCAN_MAX_PAGES=20
# DEEPL_API_KEY=            # for "npm run translate -- --provider deepl"
# LIBRETRANSLATE_URL=       # for "npm run translate -- --provider libretranslate"
